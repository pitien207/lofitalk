# Copy to backend/.env for local development. Never commit real values.
# In Azure Container Apps, set these as environment variables / secrets instead.

# --- Server ---
# Port the server listens on. Local dev uses 5001 (the Vite dev server calls it);
# the Docker image defaults to 8080.
PORT=5001
# production = serve frontend/dist, secure cookies
NODE_ENV=development

# --- Database (required) ---
# Local:  mongodb://localhost:27017/lofitalk
# Azure DocumentDB: copy the connection string from the portal, put the database
# name before "?", and URL-encode special characters in the password (@ : / ? # % etc.).
# mongodb+srv://<user>:<url-encoded-password>@<cluster>.global.mongocluster.cosmos.azure.com/lofitalk?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000
MONGO_URI=mongodb://localhost:27017/lofitalk
# Optional separate database for chat; leave empty to share MONGO_URI.
CHAT_MONGO_URI=
# Optional, default 10.
MONGO_MAX_POOL_SIZE=

# --- Auth (required) ---
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=

# --- Public URLs ---
# Comma-separated origins allowed for CORS and Socket.IO.
FRONTEND_URLS=http://localhost:5173
# Absolute base used when saving avatar URLs (production: https://lofitalk.nghiapham.org).
ASSET_BASE_URL=

# --- Tarot (Anthropic Claude, server-side only) ---
ANTHROPIC_API_KEY=
# Optional, default claude-haiku-5-5.
ANTHROPIC_MODEL=

# --- Email (optional, for password reset) ---
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# --- Mobile (optional) ---
# Latest mobile app version reported by GET /api/meta/version.
MOBILE_APP_VERSION=
